# Copy to .env (never commit .env). All values below are PLACEHOLDERS - choose your own.

# Database password (Oracle). NOTE: if you already have an oracle-data volume created by the previous
# version, set this to the password that volume was created with (the old default was RefundGuard123),
# otherwise the app cannot connect. For a fresh volume, choose a new strong value.
RG_DB_PASSWORD=change-me-db-password

# First-start users (only used while rg_users is empty). Min 12 chars, at least one letter and one digit.
RG_ADMIN_USERNAME=admin
RG_ADMIN_PASSWORD=change-me-Admin-pass-123
# Optional demo accounts: created only when a password is set.
RG_OPERATOR_PASSWORD=
RG_REVIEWER_PASSWORD=

# Razorpay webhook signing secret (empty = webhooks rejected, simulator signed-webhook demo unavailable)
RAZORPAY_WEBHOOK_SECRET=

# Optional Claude AI root-cause analysis
ANTHROPIC_API_KEY=

# Set to false to disable all /api/simulator/* demo endpoints
RG_SIMULATOR_ENABLED=true

# Risk: refunds scoring >= this are placed ON_HOLD (default 50). Other weights: see application.properties
REFUNDGUARD_RISK_HOLD_MIN_SCORE=50
